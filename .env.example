# ============================================================================
# CRM Reference Architecture - Infrastructure Environment
# Copy to crm-infra/.env (git-ignored) and fill in the secrets marked REQUIRED.
# Read by crm-infra/compose.yaml and exported by every script in crm-infra/scripts.
# ============================================================================

# ----------------------------------------------------------------------------
# LocalStack licensing (REQUIRED for the aws and azure profiles)
# Both emulators need an auth token since March 2026 (free Hobby plan works
# for AWS; LocalStack for Azure is in public preview). Get one at
# https://app.localstack.cloud/workspace/auth-tokens
# ----------------------------------------------------------------------------
LOCALSTACK_AUTH_TOKEN=

# Image tags (pin a calendar version such as 2026.10.0 for reproducible runs)
LOCALSTACK_AWS_IMAGE_TAG=latest
LOCALSTACK_AZURE_IMAGE_TAG=latest

# Gateway ports. Both emulators can run side by side; if you only ever run the
# Azure emulator you may set LOCALSTACK_AZURE_PORT=4566 (the LocalStack default).
LOCALSTACK_AWS_PORT=4566
LOCALSTACK_AZURE_PORT=4567

# Interface for every published port. Keep 127.0.0.1 on Docker Desktop; on a
# Linux Docker engine use 0.0.0.0 so schema migrators can reach host-gateway.
HOST_BIND_ADDRESS=127.0.0.1

# Docker network shared by the emulators and the containers they spawn.
DOCKER_NETWORK_NAME=crm-cloud-emulation

# Persist emulator state across restarts (1 = on) and verbose logging (1 = on).
LOCALSTACK_PERSISTENCE=0
LOCALSTACK_DEBUG=0

# Microsoft SQL Server EULA (RDS for SQL Server, Azure SQL and the local container).
MSSQL_ACCEPT_EULA=Y

# ----------------------------------------------------------------------------
# AWS SDK / Terraform AWS provider -> LocalStack (dummy credentials)
# Replace with real credentials (and set TF_VAR_localstack_enabled=false) to
# deploy the identical stack to a real AWS account.
# ----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# ----------------------------------------------------------------------------
# Azure SDK / Terraform AzureRM provider -> LocalStack for Azure
# The emulator accepts any service principal in its single emulated tenant.
# Replace with a real service principal for real Azure deployments.
# ----------------------------------------------------------------------------
ARM_CLIENT_ID=any-app
ARM_CLIENT_SECRET=dummy
ARM_TENANT_ID=00000000-0000-0000-0000-000000000000
ARM_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# ----------------------------------------------------------------------------
# Terraform overrides (any variable of crm-infra/terraform/{aws,azure} can be set
# as TF_VAR_<name>; the scripts derive the LocalStack endpoints automatically)
# ----------------------------------------------------------------------------
# TF_VAR_localstack_enabled=true
# TF_VAR_image_platform=linux/arm64
# TF_VAR_seed_data=standard

# ----------------------------------------------------------------------------
# Local (no cloud) profile - development-only credentials
# ----------------------------------------------------------------------------
SEED_DATA=standard
LOCAL_MSSQL_SA_PASSWORD=CrmDev2026!Secure#Pass
LOCAL_MSSQL_PORT=11433
LOCAL_POSTGRES_USER=postgres
LOCAL_POSTGRES_PASSWORD=postgres
LOCAL_POSTGRES_PORT=15432
LOCAL_CSHARP_API_PORT=8081
LOCAL_KOTLIN_API_PORT=8082
